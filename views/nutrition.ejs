<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nutrition - FitLife</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <!-- Navigation -->
    <nav>
        <div class="container">
            <h1>FitLife</h1>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/videos">Videos</a></li>
                <li><a href="/nutrition">Nutrition</a></li>
                <li><a href="/health">Health</a></li>
            </ul>
        </div>
    </nav>
    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h1>Healthy Nutrition</h1>
            <p>
                Fuel your body with the right nutrients to support your fitness goals.
            </p>
        </div>
    </section>

    <!-- Nutrition Tips Section -->
    <section class="section">
        <h2>Nutrition Tips</h2>
        <div class="card-grid">
            <div class="card">
                <h3>Balanced Meals</h3>
                <p>Include a mix of proteins, carbs, and fats in every meal to maintain energy levels.</p>
            </div>
            <div class="card">
                <h3>Hydration</h3>
                <p>Drink at least 8 glasses of water daily to stay hydrated and support metabolism.</p>
            </div>
            <div class="card">
                <h3>Portion Control</h3>
                <p>Use smaller plates and measure portions to avoid overeating.</p>
            </div>
            <div class="card">
                <h3>Whole Foods</h3>
                <p>Focus on whole, unprocessed foods like fruits, vegetables, lean meats, and whole grains.</p>
            </div>
        </div>
    </section>

    <!-- Recipes Section -->
    <section class="section recipes">
        <h2>Healthy Recipes</h2>
        <div class="card-grid">
            <div class="card recipe-card">
                <h3>Grilled Chicken Salad</h3>
                <p>Ingredients: Grilled chicken, mixed greens, cherry tomatoes, cucumber, olive oil dressing.</p>
                <p class="calories">Calories: ~350 | Protein: 30g</p>
            </div>
            <div class="card recipe-card">
                <h3>Quinoa Bowl</h3>
                <p>Ingredients: Quinoa, avocado, black beans, corn, lime dressing.</p>
                <p class="calories">Calories: ~400 | Protein: 15g</p>
            </div>
            <div class="card recipe-card">
                <h3>Smoothie Bowl</h3>
                <p>Ingredients: Banana, spinach, almond milk, chia seeds, topped with berries.</p>
                <p class="calories">Calories: ~250 | Protein: 10g</p>
            </div>
        </div>
    </section>
</body>
</html>