<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FitLife - Fitness and Nutrition</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <!-- Navigation -->
    <nav>
        <div class="container">
            <h1>FitLife</h1>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/videos">Videos</a></li>
                <li><a href="/nutrition">Nutrition</a></li>
                <li><a href="/health">Health</a></li>
            </ul>
        </div>
    </nav>
    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h1>FitLife</h1>
            <p>
                Your all-in-one fitness and nutrition platform designed to help you train smarter, eat healthier, and reach your goals.
            </p>
            <a class="btn btn-primary" href="/health">Start Your Journey</a>
        </div>
    </section>

    <!-- Video Workouts Section -->
    <section class="section">
        <h2>Key Workout Videos</h2>
        <div class="card-grid">
            <div class="card">
                <h3>Core Workout</h3>
                <iframe width="100%" height="315" src="https://www.youtube.com/embed/7w8aEZX9j3c" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
            <div class="card">
                <h3>Strength Training</h3>
                <iframe width="100%" height="315" src="https://www.youtube.com/embed/vc1E5CfRfz4" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
            <div class="card">
                <h3>Weight Loss HIIT</h3>
                <iframe width="100%" height="315" src="https://www.youtube.com/embed/2pLT-olgUJs" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
        </div>
    </section>

    <!-- Nutrition Section -->
    <section class="bg-white py-16 px-6">
        <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10 items-center">
            <div>
                <h2 class="text-3xl font-bold mb-4">Healthy Nutrition</h2>
                <p class="text-gray-600 mb-6">
                    Nutrition is just as important as exercise. Explore healthy meal ideas, calorie-friendly recipes, and meal plans built for your lifestyle.
                </p>
                <ul class="space-y-3">
                    <li class="bg-gray-100 p-3 rounded-xl shadow-sm">High-Protein Breakfast Bowl</li>
                    <li class="bg-gray-100 p-3 rounded-xl shadow-sm">Grilled Chicken Salad</li>
                    <li class="bg-gray-100 p-3 rounded-xl shadow-sm">Healthy Smoothie Recipes</li>
                    <li class="bg-gray-100 p-3 rounded-xl shadow-sm">Low-Calorie Dinner Ideas</li>
                </ul>
            </div>
            <div class="bg-gray-200 h-80 rounded-3xl flex items-center justify-center text-gray-500 text-xl font-semibold">
                Fitness Image Placeholder
            </div>
        </div>
    </section>
</body>
</html>
}